<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".GestionEmployesActivity">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1976D2"
        android:orientation="vertical"
        android:padding="16dp"
        tools:ignore="MissingConstraints">

        <ImageView
            android:id="@+id/img_home"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="start"
            android:contentDescription="Icône maison"
            android:src="@drawable/ic_home"
            app:tint="#FFFFFF"
            android:layout_marginTop="30dp"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/gestion_ressource"
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="30dp"
            tools:ignore="RtlSymmetry,UseCompoundDrawables">

            <ImageView
                android:id="@+id/img_group"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_person_white"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/txt_gest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Gestion des Ressources Humaines"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/filters_bar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <EditText
            android:id="@+id/editTextSearch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="12dp"
            android:hint="Rechercher par nom, prénom ou matricule..."
            android:importantForAutofill="yes"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#000000"
            android:textSize="14sp"
            tools:ignore="HardcodedText,SpeakableTextPresentCheck" />

        <!-- Boutons d'action -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btn_ajouter"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#1976D2"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Ajouter"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                tools:ignore="HardcodedText,SpeakableTextPresentCheck" />

            <!-- Bouton Modifier -->
            <Button
                android:id="@+id/btn_edit"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#1976D2"
                android:text="Update"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                tools:ignore="HardcodedText,SpeakableTextPresentCheck"/>

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#1976D2"
                android:text="delete"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                tools:ignore="HardcodedText,SpeakableTextPresentCheck"/>

        </LinearLayout>
    </LinearLayout>

    <ListView
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:id="@+id/listViewEmployes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filters_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>